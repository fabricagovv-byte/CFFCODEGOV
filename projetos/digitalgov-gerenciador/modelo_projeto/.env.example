# Copie para .env. O comando "projeto criar --criar-banco" do gerenciador já gera este arquivo com a senha.
DATABASE_URL=postgresql+psycopg://{{USUARIO_BANCO}}:SENHA@127.0.0.1:5432/{{BANCO}}
# Banco de TESTE (é apagado pelos testes)
TEST_DATABASE_URL=postgresql+psycopg://{{USUARIO_BANCO}}:SENHA@127.0.0.1:5432/{{BANCO}}_teste
# Token combinado com o gerenciador para o botão START (o mesmo valor fica em {{VAR_TOKEN}} no .env do gerenciador)
GERENCIADOR_TOKEN=
PORTA={{PORTA}}
