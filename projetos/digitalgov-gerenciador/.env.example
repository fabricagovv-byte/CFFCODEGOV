# Copie para .env e preencha. O .env nunca vai para o repositório.
# Banco central do gerenciador (PostgreSQL). Troque SENHA pela senha criada no passo do manual.
GERENCIADOR_DATABASE_URL=postgresql+psycopg://gerenciador_app:SENHA@127.0.0.1:5432/digitalgov_gerenciador
# Pasta onde ficam os editais e documentos enviados
GERENCIADOR_ARQUIVOS=./dados/arquivos
# Pasta que contém as pastas dos projetos (para ler o histórico do git)
GERENCIADOR_PROJETOS_DIR=..
GERENCIADOR_MAX_UPLOAD_MB=25
GERENCIADOR_JORNADA_HORAS=8
GERENCIADOR_SESSAO_HORAS=8
# Conexão de cada projeto: uma variável por projeto, com o nome cadastrado no gerenciador
# PROJ_EXEMPLO_PROTOCOLO_DATABASE_URL=postgresql+psycopg://proj_exemplo_app:SENHA@127.0.0.1:5432/proj_exemplo_protocolo
# PROJ_EXEMPLO_PROTOCOLO_TOKEN=gere-um-token-longo
