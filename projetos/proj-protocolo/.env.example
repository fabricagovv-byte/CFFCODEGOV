# Copie para .env. O comando "projeto criar --criar-banco" do gerenciador já gera este arquivo com a senha.
DATABASE_URL=postgresql+psycopg://proj_protocolo_app:SENHA@127.0.0.1:5432/proj_protocolo
# Banco de TESTE (é apagado pelos testes)
TEST_DATABASE_URL=postgresql+psycopg://proj_protocolo_app:SENHA@127.0.0.1:5432/proj_protocolo_teste
# Token combinado com o gerenciador para o botão START (o mesmo valor fica em PROJ_PROTOCOLO_TOKEN no .env do gerenciador)
GERENCIADOR_TOKEN=
PORTA=8100
