# Copie para .env e preencha. Nunca versione o .env.
# Segredo dos tokens de acesso (32+ caracteres): python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
DG_COMM_SECRET=
# Chave do painel da fábrica (32+ caracteres)
DG_FACTORY_TOKEN=
# Porta HTTP local do ambiente de desenvolvimento
PORTA_HTTP=8080
# Produção: domínio e pasta dos certificados TLS
DOMINIO=
CERTS_DIR=./infra/certs
# Execução sem Docker: por padrão os bancos ficam em PLATAFORMA_COMUNICACAO/data/ e FABRICA/data/.
# Para outro local, use caminho absoluto:
# DG_COMM_DB=/srv/dados/comunicacao.db
# DG_FACTORY_DB=/srv/dados/factory.db
