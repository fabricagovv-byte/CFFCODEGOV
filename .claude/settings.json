{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 fabrica/ferramentas/fabrica.py:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx vitest run:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*.local)",
      "Bash(docker compose -f docker-compose.yml -f docker-compose.prod.yml up:*)",
      "Bash(git push --force:*)"
    ]
  }
}
