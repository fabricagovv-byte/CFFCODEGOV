# Copie para .env e TROQUE todos os valores marcados. Nunca versione o .env.
APP_ENV=dev
POSTGRES_DB=gestao_documental
POSTGRES_USER=gd_app
POSTGRES_PASSWORD=TROQUE-senha-forte-do-banco
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=TROQUE-gere-um-segredo-com-48-bytes-ou-mais-aleatorios
MAX_UPLOAD_MB=20
PORTA_HTTP=8080
URL_PUBLICA=http://localhost:8080
# Proxy corporativo com inspeção TLS (opcional, só para o build)
# CA_EXTRA_FILE=/caminho/ca-corporativa.crt
# Somente produção
DOMINIO=documentos.exemplo.gov.br
CERTS_DIR=./infra/certs
# Carga inicial (python -m app.seed)
ADMIN_EMAIL=admin@exemplo.gov.br
ADMIN_SENHA=TROQUE-SenhaAdmin2026
